<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="details"
        label="COM_VDEDITORIBGE_FIELDSET_DETAILS_LABEL">

        <field
            name="id"
            type="text"
            label="JGLOBAL_FIELD_ID_LABEL"
            description="JGLOBAL_FIELD_ID_DESC"
            readonly="true"
            class="readonly"
            default="0" />

        <field
            name="domain"
            type="text"
            label="COM_VDEDITORIBGE_FIELD_DOMAIN_LABEL"
            description="COM_VDEDITORIBGE_FIELD_DOMAIN_DESC"
            required="true"
            size="40"
            class="inputbox validate-domain"
            filter="string" />

        <field
            name="home"
            type="radio"
            label="COM_VDEDITORIBGE_FIELD_HOME_LABEL"
            description="COM_VDEDITORIBGE_FIELD_HOME_DESC"
            default="0"
            class="btn-group btn-group-yesno">
            <option value="1">JYES</option>
            <option value="0">JNO</option>
        </field>

        <field
            name="menuid"
            type="text"
            label="COM_VDEDITORIBGE_FIELD_MENUID_LABEL"
            description="COM_VDEDITORIBGE_FIELD_MENUID_DESC"
            required="true"
            filter="integer"
            default="0"/>

        <field
            name="template"
            type="text"
            label="COM_VDEDITORIBGE_FIELD_TEMPLATE_LABEL"
            description="COM_VDEDITORIBGE_FIELD_TEMPLATE_DESC"
            size="40"
            filter="string" />

        <field
            name="template_style_id"
            type="text"
            label="COM_VDEDITORIBGE_FIELD_TEMPLATE_STYLE_ID_LABEL"
            description="COM_VDEDITORIBGE_FIELD_TEMPLATE_STYLE_ID_DESC"
            required="true"
            filter="integer"
            default="0"/>

        <field
            name="viewlevel"
            type="text"
            label="COM_VDEDITORIBGE_FIELD_VIEWLEVEL_LABEL"
            description="COM_VDEDITORIBGE_FIELD_VIEWLEVEL_DESC"
            required="true"
            filter="integer"
            default="0"/>

        <field
            name="published"
            type="radio"
            label="JSTATUS"
            description="COM_VDEDITORIBGE_FIELD_PUBLISHED_DESC"
            default="0"
            class="btn-group btn-group-yesno">
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="-2">JTRASHED</option> <!-- Adicionar se usarmos lixeira -->
        </field>

        <field
            name="ordering"
            type="text"
            label="JFIELD_ORDERING_LABEL"
            description="JFIELD_ORDERING_DESC"
            readonly="true"
            class="readonly" />

        <field
            name="menufilter_json"
            type="textarea"
            label="COM_VDEDITORIBGE_FIELD_MENUFILTER_JSON_LABEL"
            description="COM_VDEDITORIBGE_FIELD_MENUFILTER_JSON_DESC"
            rows="10"
            cols="80"
            filter="raw"
            hint="COM_VDEDITORIBGE_FIELD_MENUFILTER_JSON_HINT" />

        <field
            name="categoryfilter_json"
            type="textarea"
            label="COM_VDEDITORIBGE_FIELD_CATEGORYFILTER_JSON_LABEL"
            description="COM_VDEDITORIBGE_FIELD_CATEGORYFILTER_JSON_DESC"
            rows="10"
            cols="80"
            filter="raw"
            hint="COM_VDEDITORIBGE_FIELD_CATEGORYFILTER_JSON_HINT" />

         <field
            name="checked_out"
            type="hidden"
            filter="unset" />
        <field
            name="checked_out_time"
            type="hidden"
            filter="unset" />
    </fieldset>
</form>
